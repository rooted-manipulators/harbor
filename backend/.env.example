# Copy to .env and fill in from the Supabase dashboard (Settings -> API).
# .env is gitignored. Never commit real values.

SUPABASE_URL=https://<project-ref>.supabase.co

# Safe to ship in the Android app. RLS is what protects the data, not this key.
SUPABASE_ANON_KEY=

# Bypasses RLS. Local tooling and study exports only.
# Never put this in the app, in CI logs, or in a Slack message.
SUPABASE_SERVICE_ROLE_KEY=

# --- the WhatsApp bot (ADR-014) ----------------------------------------------
# These four have to reach the deployed function, not just sit in this file.
# Either add them by hand in the dashboard (Project Settings -> Edge Functions
# -> Secrets), or push them:
#
#   supabase secrets set --env-file <a file holding ONLY these four>
#
# Not this file, and not a straight copy of it. Supabase reserves the
# SUPABASE_ prefix for the secrets it injects itself, and rejects the whole
# command if the file it is given contains one -- so a .env that still has the
# three keys above in it fails, confusingly, without setting anything.
#
# The function never needs SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY set here:
# the platform injects both. It uses the service role because schedule_inbox
# has no insert policy, on purpose.

# Any string you invent. Typed into Meta's webhook setup and echoed back on
# its one-time subscription handshake.
WHATSAPP_VERIFY_TOKEN=

# Meta app dashboard -> App settings -> Basic -> App secret. Every webhook body
# is HMAC-signed with it. Without it the endpoint would be a public write into
# any paired participant's week, so the function refuses every POST while it is
# blank rather than running unsigned.
WHATSAPP_APP_SECRET=

# Permanent access token for the WhatsApp Business account, and the id of the
# number it sends from. Only used to reply: leave them blank and the bot still
# reads and files, it just says nothing back.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
